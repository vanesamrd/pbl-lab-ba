{
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.3"
    }
  },
  "routes": [
    {
      "src": "/lab-ba/public/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/lab-ba/public/uploads/(.*)",
      "dest": "/public/uploads/$1"
    },
    {
      "src": "/lab-ba/public/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/lab-ba/admin/(.*)",
      "dest": "/api/index.php"
    },
    {
      "src": "/assets/(.*)",
      "dest": "/public/assets/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/public/uploads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ]
}
